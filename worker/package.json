{
  "name": "lockpick-leaderboard",
  "private": true,
  "type": "module",
  "description": "Leaderboard API for the lockpicking mini-game (Cloudflare Worker + D1).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute lockpick-leaderboard --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute lockpick-leaderboard --local --file schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.152.0"
  }
}
